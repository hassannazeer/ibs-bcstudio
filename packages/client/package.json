{
  "name": "@ilmora/bc-client",
  "version": "0.1.0",
  "description": "HTTP client for Business Central OData v4 APIs — handles OAuth2, ETag, rate-limiting and pagination",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@ilmora/bc-types": "*"
  },
  "keywords": ["business-central", "bc", "odata", "oauth2", "typescript"],
  "license": "MIT"
}
