{
  "name": "@ilmora/bc-client",
  "version": "0.1.0",
  "description": "HTTP client for Business Central OData v4 APIs — handles OAuth2, ETag, rate-limiting and pagination",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@ilmora/bc-types": "^0.1.0"
  },
  "keywords": [
    "business-central",
    "bc",
    "odata",
    "oauth2",
    "typescript"
  ],
  "license": "MIT",
  "author": "Ilmora",
  "homepage": "https://github.com/hassannazeer/ibs-bcstudio/tree/main/packages/client#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassannazeer/ibs-bcstudio.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/hassannazeer/ibs-bcstudio/issues"
  }
}
