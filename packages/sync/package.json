{
  "name": "@ilmora/bc-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade BC→destination sync engine. Handles silent $filter detection, millisecond timestamp quirks, ETag-safe pagination, deduplication, change detection and pluggable adapters.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import":  "./dist/index.js",
      "require": "./dist/index.cjs",
      "types":   "./dist/index.d.ts"
    },
    "./adapters/supabase": {
      "import":  "./dist/adapters/supabase.js",
      "require": "./dist/adapters/supabase.cjs",
      "types":   "./dist/adapters/supabase.d.ts"
    },
    "./adapters/sqlserver": {
      "import":  "./dist/adapters/sqlserver.js",
      "require": "./dist/adapters/sqlserver.cjs",
      "types":   "./dist/adapters/sqlserver.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev":   "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@ilmora/bc-client": "*",
    "@ilmora/bc-types":  "*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": ">=2.0.0",
    "mssql": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": { "optional": true },
    "mssql":                 { "optional": true }
  },
  "keywords": ["business-central", "bc", "sync", "odata", "supabase", "sqlserver", "etl", "incremental"],
  "license": "MIT"
}
