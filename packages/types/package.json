{
  "name": "@ilmora/bc-types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for the Business Central SDK",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "keywords": ["business-central", "bc", "typescript", "odata"],
  "license": "MIT"
}
